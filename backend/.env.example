APP_NAME=Government Reservation API
HOST=0.0.0.0
PORT=7171
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reservation_management?sslmode=disable
JWT_SECRET=change-this-secret-before-production
JWT_EXPIRES_IN_HOURS=8
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_FULL_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@finance.local

# true = reset the default admin password from DEFAULT_ADMIN_PASSWORD on next start (then set back to false)
RESET_ADMIN_PASSWORD=false

# Apply new database/migrations files on API start (a pg_dump backup is taken first)
AUTO_MIGRATE=true
BACKUP_BEFORE_MIGRATE=true
# MIGRATIONS_DIR=migrations
