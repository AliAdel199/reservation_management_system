APP_NAME=Government Reservation API
HOST=0.0.0.0
PORT=7070
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/reservation_management?sslmode=disable
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN_HOURS=8
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_FULL_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@finance.local
AUTO_SEED_ADMIN=true

# License protection
# Keep false while preparing the server. Set true after placing license.json and license_public.pem.
LICENSE_ENFORCEMENT=false
LICENSE_FILE=license.json
LICENSE_PUBLIC_KEY=license_public.pem
